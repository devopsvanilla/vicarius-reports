# Credenciais obrigatórias para todos os scripts Vicarius
VICARIUS_API_KEY=YOUR_API_KEY           # Token de API Vicarius (obrigatório)
VICARIUS_BASE_URL=https://YOUR_INSTANCE.vicarius.cloud  # URL base da API Vicarius (obrigatório)

# Ajustes de performance e resiliência (opcionais)
# (valores padrão entre parênteses)

# Intervalo (segundos) entre requests à API Vicarius em get_endpoint_so.py
VRX_REQUEST_DELAY=1.05                  # Default: 1.05

# Número máximo de tentativas de retry para erros HTTP/429/5xx em get_endpoint_so.py
VRX_MAX_RETRIES=6                       # Default: 6

# Base do backoff exponencial para retry em get_endpoint_so.py
VRX_BACKOFF_BASE=2                      # Default: 2

# Intervalo de progresso/logs em get_endpoint_so.py
VRX_PROGRESS_INTERVAL=500               # Default: 500

# Delay (segundos) entre páginas SEEK na coleta de CVEs em get_active_cve.py
VRX_VULN_REQUEST_DELAY_SEC=0            # Default: 0
