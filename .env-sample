# Credenciais obrigatórias para todos os scripts Vicarius
VICARIUS_API_KEY=YOUR_API_KEY           # Token de API Vicarius (obrigatório)
VICARIUS_BASE_URL=https://YOUR_INSTANCE.vicarius.cloud  # URL base da API Vicarius (obrigatório)

# Ajustes de performance e resiliência (opcionais)
# (valores padrão entre parênteses)

# Intervalo (segundos) entre requests à API Vicarius em get_endpoint_so.py
VRX_REQUEST_DELAY=1.05                  # Default: 1.05

# Número máximo de tentativas de retry para erros HTTP/429/5xx em get_endpoint_so.py
VRX_MAX_RETRIES=6                       # Default: 6

# Base do backoff exponencial para retry em get_endpoint_so.py
VRX_BACKOFF_BASE=2                      # Default: 2

# Intervalo de progresso/logs em get_endpoint_so.py
VRX_PROGRESS_INTERVAL=500               # Default: 500

# Delay (segundos) entre páginas SEEK na coleta de CVEs em get_active_cve.py
VRX_VULN_REQUEST_DELAY_SEC=0            # Default: 0

# Envio de e-mail dos relatórios gerados por get_active_cve.py (opcional)
VRX_EMAIL_ENABLED=false                 # true para habilitar envio ao final da execução
VRX_SMTP_HOST=smtp.seudominio.com       # Servidor SMTP
VRX_SMTP_PORT=587                       # Porta SMTP (587 STARTTLS, 465 SSL)
VRX_SMTP_USER=seu_usuario_smtp          # Usuário SMTP (se aplicável)
VRX_SMTP_PASSWORD=sua_senha_smtp        # Senha SMTP (se aplicável)
VRX_SMTP_USE_SSL=false                  # true para SMTP_SSL (ex.: porta 465)
VRX_SMTP_USE_STARTTLS=true              # true para STARTTLS (ex.: porta 587)
VRX_EMAIL_FROM=relatorios@seudominio.com  # Remetente do e-mail
VRX_EMAIL_TO=destinatario1@seudominio.com,destinatario2@seudominio.com  # Lista separada por vírgula
VRX_EMAIL_SUBJECT=Relatorio de Vulnerabilidades Ativas  # Assunto do e-mail
VRX_EMAIL_BODY=Segue em anexo o relatorio de vulnerabilidades ativas (XLSX e CSV).  # Corpo do e-mail
